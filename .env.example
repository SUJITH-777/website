# Vercel → Project → Settings → Environment Variables (Production / Preview / Development)
# Never use VITE_* for secrets — these are server-only (api/contact.ts).
#
# Local: copy this file to `.env.local` (gitignored) in the project root, fill SMTP_* values,
# then run `npm run dev:vercel` (uses `npx vercel`) so `/api/contact` is served with Vite.
# runs with Vite. Plain `npm run dev` does not serve `api/*` routes.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Swarn Aayu <noreply@example.com>"
CONTACT_MAIL_TO=contact@swarnaayu.com

# Optional: comma-separated origins for cross-origin tests (e.g. http://localhost:8080).
# Leave unset for normal same-origin production traffic on Vercel.

# ALLOWED_ORIGINS=https://www.swarnaayu.com,http://localhost:8080
